# Datos de origen y derivados: nunca deben subirse a este repositorio.
# El repo solo debe contener el dashboard publicado y el código del pipeline
# que lo genera, no los Excel/JSON con cifras reales por RBD.
*.xlsx
*.xls
*.xlsm
*.csv
CARGA/
carga_manual/
*.json
!package.json
# Dato de referencia normativo (matriz del Manual de Cuentas SUPEREDUC 2026), sin cifras por RBD.
!data/plan_cuentas_2026.json

# Artefactos de trabajo / respaldos locales
*_backup_*.html
.DS_Store
__pycache__/
*.pyc

# Arnés de pruebas (tests/): fixtures, línea base del golden master y package.json SÍ se versionan
# (son datos sintéticos generados por script, sin cifras reales). Lo regenerable queda fuera.
!tests/package.json
!tests/**/*.json
tests/.cache/
tests/.tmp/
tests/out/

# Arnés contra el SDK real de Firestore (tests/e2e-real): lo regenerable queda fuera; las dependencias viven en E2E_HOME (fuera del repo).
tests/e2e-real/.cache/
tests/e2e-real/node_modules/
