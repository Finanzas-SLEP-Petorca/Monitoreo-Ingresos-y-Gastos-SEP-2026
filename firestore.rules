// Reglas de seguridad Firestore — proyecto "slep-petorca-finanzas-permisos"
// Para desplegar: Firebase Console → Firestore Database → Reglas → pegar este contenido →
// Publicar. Para agregar/quitar correos: editar la lista de isAllowed() de abajo Y la
// constante ALLOWED_EMAILS en index.html (de este repo y de Calendariopermisos).
//
// Este proyecto Firebase aloja DOS apps con colecciones independientes en la misma base de
// datos, así que sus reglas viven juntas en un solo archivo (Firestore solo permite un
// conjunto de reglas por base de datos):
//   - "events"        → Calendariopermisos (github.com/Finanzas-SLEP-Petorca/Calendariopermisos)
//   - "sep_carga_rbd" → este panel (Monitoreo Ingresos y Gastos SEP 2026)
// Si se edita el bloque de una colección, no tocar el bloque de la otra — y mantener este
// archivo igual al que está publicado en Firebase Console en ambos repositorios, ya que es el
// mismo archivo real desplegado para las dos apps.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowed() {
      return request.auth != null && request.auth.token.email in [
        "wilson.rojas@sleppetorca.gob.cl",
        "juan.bustamante@sleppetorca.gob.cl",
        "benedicto.fessia@sleppetorca.gob.cl",
        "sebastian.olguin@sleppetorca.gob.cl",
        "fernando.saavedra@sleppetorca.gob.cl",
        "yessenia.vilches@sleppetorca.gob.cl",
        "catalina.brito@sleppetorca.gob.cl",
        "wilson.rojasabarca@gmail.com",
        "javier.ilabaca@sleppetorca.gob.cl"
      ];
    }

    // --- Calendariopermisos ---
    function validEventData() {
      return request.resource.data.keys().hasAll(["date", "memberId", "type"])
        && request.resource.data.date is string
        && request.resource.data.memberId is string
        && request.resource.data.type is string
        && request.resource.data.type in ["feriado","permiso","licencia","compensacion","otro"];
    }
    match /events/{eventId} {
      allow read:   if isAllowed();
      allow create: if isAllowed() && validEventData();
      allow update: if isAllowed();
      allow delete: if isAllowed();
    }

    // --- Monitoreo Ingresos y Gastos SEP 2026 ---
    // Un documento por RBD (id = RBD, p.ej. "1121") + un documento "_meta" con la lista
    // compartida de ítems de gasto (items_22 / items_29). No se borran RBD desde el cliente:
    // el panel nunca da de baja un establecimiento, solo edita sus montos.
    match /sep_carga_rbd/{rbdId} {
      allow read:   if isAllowed();
      allow create, update: if isAllowed();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
