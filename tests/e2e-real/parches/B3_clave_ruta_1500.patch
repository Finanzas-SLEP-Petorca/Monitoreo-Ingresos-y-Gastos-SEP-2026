+const MAX_BYTES_CLAVE_MAPA = 1400;
 function validarClaveMapa(clave, etiqueta = 'El nombre') {
   if (typeof clave !== 'string' || clave.trim() === '') return `${etiqueta} no puede estar vacío.`;
   if (/^__.*__$/.test(clave)) return `${etiqueta} "${clave}" no es válido: no puede empezar y terminar con "__" (Firestore lo rechaza).`;
